# ============================================================
# Copie este arquivo para ".env" (na raiz do projeto, ao lado do pom.xml)
# e preencha com os SEUS valores. O arquivo ".env" NUNCA vai para o GitHub.
# ============================================================

# --- MongoDB Atlas (obrigatório) ---
# Atlas > Connect > Drivers. Troque usuario, senha e o endereço do cluster.
# Se a senha tiver caracteres especiais (@ : / # %), codifique-os (ex.: @ vira %40).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# --- Primeiro administrador (obrigatório) ---
# Criado automaticamente na primeira execução, se ainda não existir.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=defina-uma-senha-forte

# --- E-mail (recuperação de senha e código do 2FA) ---
# Exemplo com Gmail: ative a verificação em duas etapas e crie uma "senha de app".
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-caracteres
MAIL_FROM=seu-email@gmail.com

# --- Link usado nos e-mails (padrão: http://localhost:8080) ---
# APP_BASE_URL=http://localhost:8080

# --- Atalhos para quem NÃO configurar o e-mail (somente desenvolvimento) ---
# Mostra o código do 2FA e o link de recuperação no console:
DOIS_FATORES_LOG_CODIGO=true
RECUPERACAO_LOG_LINK=true
# Ou desliga o 2FA por completo:
# DOIS_FATORES_ATIVO=false
